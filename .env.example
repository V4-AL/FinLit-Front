# Base URL for the FinLit backend API (Spring Boot). Must include the /api prefix.
# Expo exposes any EXPO_PUBLIC_ prefixed variable to client code via process.env.
# Copy this file to .env.local and point it at your dev/staging/production backend.
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Firebase project config (Project settings > General > Your apps > SDK setup and configuration).
# Used to authenticate users client-side; the resulting ID token is sent as a Bearer token on
# every backend request (see src/services/api.ts) and verified server-side.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
